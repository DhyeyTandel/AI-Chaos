{
  "name": "AI-Chaos",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "git submodule update --init --recursive && pip install -e '.[dev]'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Astronomy Shop", "onAutoForward": "notify" }
  },
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Free key from console.groq.com. Optional: without it the planner uses the deterministic fallback."
    }
  }
}
